apiVersion: 1
providers:
  - name: podobank-repository
    orgId: 1
    folder: PodoBank Lab
    folderUid: podobank-lab
    type: file
    disableDeletion: {{ 'false' if grafana_retirement | default(false) else 'true' }}
    allowUiUpdates: false
    updateIntervalSeconds: 30
    options:
      path: /var/lib/grafana/dashboards/podobank
