    {
      "id": 7,
      "title": "MariaDB 원장 · 종류별 실제 저장 건수",
      "type": "table",
      "description": "송금 한 건은 transfer_out·transfer_in 두 원장 기록입니다. loan_disbursement는 대출 승인 후 실제 지급 기록입니다.",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "podobank-prometheus"
      },
      "targets": [
        {
          "refId": "A",
