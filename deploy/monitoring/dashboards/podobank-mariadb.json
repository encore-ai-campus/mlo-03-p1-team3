    {
      "id": 4,
      "title": "DB 저장 용량",
      "type": "stat",
      "description": "MariaDB는 테이블 데이터+인덱스 할당량, MongoDB는 storageSize+indexSize입니다. OS 디스크 전체 사용량과 다릅니다.",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "podobank-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(podobank_db_size_bytes{store=\"mariadb\",kind=\"total\",server!~\".*replica\"} and on(instance) ((podobank_business_collect_success == 1) and on(instance) (up{job=\"node\"} == 1) and on(instance) (time()-podobank_business_collect_success_timestamp_seconds < 180)))",
          "legendFormat": "{{server}}",
          "instant": true,
          "range": false,
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1,
          "min": 0,
          "noValue": "수집 없음",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "—",
                  "color": "gray"
                }
              }
            }
          ],
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "text": {
          "valueSize": 30,
          "titleSize": 14
        }
      }
    },
