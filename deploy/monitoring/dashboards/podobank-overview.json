    {
      "id": 4,
      "title": "API 요청 · 선택 기간",
      "type": "stat",
      "description": "모든 API worker의 request_completed 로그에서 계산합니다. Loki에 도착한 기록 기준이며 헬스체크는 제외합니다.",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "podobank-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"podobank\",log_type=\"application\"} | json | __error__=\"\" | message=\"request_completed\" | route!~\"/health|unmatched\"[$__range])) or (0*sum(count_over_time({job=\"podobank\",log_type=\"application\"} | json | __error__=\"\" | message=\"request_completed\"[$__range])))",
          "legendFormat": "{{server}}",
          "instant": true,
          "range": false,
          "queryType": "instant"
