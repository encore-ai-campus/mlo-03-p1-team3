        "text": {
          "valueSize": 30,
          "titleSize": 14
        },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "podobank-prometheus"
          },
          "expr": "sum(rate({job=\"podobank\",log_type=\"application\",instance=~\"$api\"} | json | __error__=\"\" | message=\"request_completed\" | route!~\"/health|unmatched\"[$__auto]))",
          "instant": true,
          "legendFormat": "{{server}}",
          "range": false,
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "title": "전체 요청률",
      "type": "stat"
    },
