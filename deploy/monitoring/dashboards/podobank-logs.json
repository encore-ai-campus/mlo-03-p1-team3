      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 7
      },
      "id": 4,
      "options": {
        "cellHeight": "sm",
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "podobank-loki"
          },
          "expr": "sum by(instance,log_type)(count_over_time({job=\"podobank\",instance=~\"${instance:regex}\"}[$__range]))",
          "format": "table",
          "instant": true,
          "legendFormat": "{{server}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "선택 기간 로그 건수 · 서버·종류",
      "type": "table",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "server": true,
              "store": true,
              "kind": true
            },
            "renameByName": {
              "dataset": "저장 대상",
              "Value": "건수",
              "Value #A": "건수",
              "Value #B": "건수"
            }
          }
        }
      ]
    },
