    {
      "datasource": {
        "type": "loki",
        "uid": "podobank-loki"
      },
      "description": "instant query로 한 번만 집계합니다. 이동창 건수를 더하지 않습니다.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
