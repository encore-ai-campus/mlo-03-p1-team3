          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never",
            "spanNulls": false
          },
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "right",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "title": "디스크 추이",
      "type": "timeseries",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "podobank-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by(server)(100*(1-node_filesystem_avail_bytes{job=\"node\",server=~\".*\",mountpoint=\"/\",fstype!=\"rootfs\"}/node_filesystem_size_bytes{job=\"node\",server=~\".*\",mountpoint=\"/\",fstype!=\"rootfs\"}))",
          "legendFormat": "{{server}}",
          "instant": false,
          "range": true,
          "queryType": "range"
