    {
      "id": 1,
      "title": "CPU 추이",
      "type": "timeseries",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "podobank-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100*(1-avg by(server)(rate(node_cpu_seconds_total{job=\"node\",server=~\".*nginx\",mode=\"idle\"}[$__rate_interval])))",
          "legendFormat": "{{server}}",
          "instant": false,
          "range": true,
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "noValue": "수집 없음",
