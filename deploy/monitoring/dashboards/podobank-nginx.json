            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "—",
                  "color": "gray"
                }
              }
            }
          ],
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never",
            "spanNulls": false
          },
          "max": 100
        },
        "overrides": []
      },
      "options": {
