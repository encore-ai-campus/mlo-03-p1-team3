# 복사해서 deploy/vm/vm.env 로 쓴다. vm.env 는 git에 올리지 않는다.
# 모든 VM 설치 스크립트가 이 파일 하나를 읽는다. 비밀번호는 영문·숫자·_·- 만 쓴다.

# --- VM 주소 (Terraform에서 고정한 IP) ---
NGINX_IP=192.168.0.191
HAPROXY_IP=192.168.0.192
API1_IP=192.168.0.193
API2_IP=192.168.0.194
MARIADB_MASTER_IP=192.168.0.195
MARIADB_REPLICA_IP=192.168.0.196
MONGODB_IP=192.168.0.197

# --- 코드 ---
REPO_URL=https://github.com/encore-ai-campus/mlo-03-p1-team3.git
REPO_REF=dev/backend

# --- MariaDB ---
MARIADB_PASSWORD=change-me
MARIADB_REPL_PASSWORD=change-me-repl
MARIADB_CLIENT_SUBNET=192.168.0.%

# --- MongoDB ---
MONGODB_VERSION=8.0
MONGODB_CLIENT_CIDR=192.168.0.0/24
MONGODB_ADMIN_PASSWORD=change-me-mongo-admin

# --- FastAPI ---
COOKIE_SECURE=false
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://192.168.0.191/auth/kakao/callback
# api-1에서만: 비워 두면 직원 계정을 만들지 않는다
EMPLOYEE_PHONE=
EMPLOYEE_PASSWORD=

# --- Alloy / Loki (set the actual endpoint before enabling Alloy) ---
LOKI_PUSH_URL=http://192.168.0.199:3100/loki/api/v1/push
PROMETHEUS_IP=192.168.0.198
LOKI_IP=192.168.0.199
GRAFANA_IP=192.168.0.200

# 테스트 설치 기본값: 재실행 시 podobank의 기존 MariaDB·MongoDB 데이터를 삭제한다.
RESET_DATABASES=true

# MongoDB monitoring-only user; private random value, 24+ URL-safe characters.
METRICS_MONGODB_PASSWORD=change-me-random-monitor-password
