# 복사해서 deploy/vm/vm.env 로 쓴다. vm.env 는 git에 올리지 않는다.
# 모든 VM 설치 스크립트가 이 파일 하나를 읽는다. 비밀번호는 영문·숫자·_·- 만 쓴다.

# --- VM 주소 (Terraform에서 고정한 IP) ---
NGINX_IP=192.168.56.10
HAPROXY_IP=192.168.56.11
API1_IP=192.168.56.21
API2_IP=192.168.56.22
MARIADB_MASTER_IP=192.168.56.31
MARIADB_REPLICA_IP=192.168.56.32
MONGODB_IP=192.168.56.41

# --- 코드 ---
REPO_URL=https://github.com/encore-ai-campus/mlo-03-p1-team3.git
REPO_REF=main

# --- MariaDB ---
MARIADB_PASSWORD=change-me
MARIADB_REPL_PASSWORD=change-me-repl

# --- MongoDB ---
MONGODB_VERSION=8.0

# --- FastAPI ---
COOKIE_SECURE=false
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://192.168.56.10/auth/kakao/callback
# api-1에서만: 비워 두면 직원 계정을 만들지 않는다
EMPLOYEE_PHONE=
EMPLOYEE_PASSWORD=
