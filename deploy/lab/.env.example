# Copy to .env on the WSL controller. Never commit the filled file.
LAN_CIDR=192.168.0.0/24
LAN_GATEWAY=192.168.0.1
# Only configure/plan/apply select a new network.
# install/verify keep the existing deployed inventory and VM addresses.
FALLBACK_LAN_CIDR=192.168.219.0/24
FALLBACK_LAN_GATEWAY=192.168.219.1
VM_IP_START=191
VM_PREFIX=podobank
LAB_REPO=/mnt/c/Users/Example/wsl-vmware-lab
BASE_VM_NAME=ubuntu24-base
VM_DIRECTORY='C:\Users\Example\Documents\Virtual Machines'
VM_SSH_KEY=/home/example/.config/podobank-lab/id_ed25519
VM_SSH_USER=ubuntu
# Existing deployment credentials are read from private deploy/vm/vm.env.
# CPU and memory are role defaults; existing disks are preserved on reapply.

# Optional HTTPS: certificates must already exist on the nginx VM.
NGINX_TLS_ENABLED=false
APP_BASE_URL=

# VMnet0 uses VMware automatic bridging; VMnet2 pins the selected Windows LAN adapter.
VM_BRIDGE_VNET=VMnet2
