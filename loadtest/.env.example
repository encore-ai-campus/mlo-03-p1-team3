# 실제 값은 본인 PC의 .env에만 입력합니다. 파일 전체를 공유하지 마세요.
# read 모드: 최고 단계 인원 이상, 서로 다른 시험 계정이 필요합니다.
# phone_number/password는 본인이 만든 시험 계정 값으로 바꿉니다.
PODOBANK_ACCOUNTS_JSON='[{"phone_number":"SET_LOCALLY","password":"SET_LOCALLY"}]'
PODOBANK_WAIT_MIN=1
PODOBANK_WAIT_MAX=3

# 재사용 송금 풀은 이 파일과 별도의 전용 경로(예: loadtest/pool/.env)에
# prepare-pool 명령으로 생성합니다. 아래는 변수 형식을 보이는 가짜 예시입니다.
# 실제 비밀번호·전화번호가 들어간 풀 파일 전체를 공유하거나 커밋하지 마세요.
# 계정별 상태 변경은 같은 변수 이름으로 .env 끝에 덧붙이며 마지막 값이 유효합니다.
# PODOBANK_TRANSFER_POOL={"version":1,"host":"http://127.0.0.1:8000","id":"GENERATED_BY_PREPARE_POOL","count":2}
# PODOBANK_TRANSFER_ACCOUNT_00000={"phone_number":"01900000000","password":"SET_LOCALLY_FAKE_ONLY","poor":false,"state":"new","funded":0}
