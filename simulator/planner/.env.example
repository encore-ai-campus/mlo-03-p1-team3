# Generated automatically on the first real Playwright plan run; keep planner/.env private.
SIMULATOR_PLAN_PASSWORD_SEED=replace_with_a_random_private_seed_of_at_least_32_characters

# Local cron runner. Keep the same password seed after accounts are registered.
SIMULATOR_BASE_URL=http://192.0.2.191
SIMULATOR_PYTHON=/absolute/path/to/python3
SIMULATOR_CONCURRENCY=5
SIMULATOR_SESSIONS_PER_TICK=10
SIMULATOR_APPROVE_LOANS=false
