{
  "name": "podobank-persona-simulator",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "simulate": "node personas/scripts/run-playwright.mjs",
    "simulate:watch": "node personas/scripts/run-playwright.mjs --watch",
    "install-browser": "playwright install chromium",
    "simulate:scheduled": "node personas/scripts/run-scheduled.mjs",
    "simulate:prepare": "node personas/scripts/run-scheduled.mjs --prepare-only"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
